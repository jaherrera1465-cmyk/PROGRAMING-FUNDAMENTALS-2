Algoritmo Convert_Kilometers_To_Meters
	// Step 1. Declare variables
	Definir kilometers, meters Como Real
	
	// Step 2. Request and read the distance in kilometers
	Escribir "Ingrese la distancia en kilometros: "
	Leer kilometers
	
	// Step 3. Convert kilometers to meters (1 km = 1000 m)
	meters <- kilometers * 1000
	
	// Step 4. Display the result
	Escribir "La distancia recorrida en metros equivalen a: ", meters, " metros."
	
	
FinAlgoritmo
