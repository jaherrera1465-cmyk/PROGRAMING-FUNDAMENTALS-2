Algoritmo Calculate_Average_Five_Numbers
	// Step 1. Declare variables
	Definir num1, num2, num3, num4, num5, promedio Como Real
	
	// Step 2. Request and read the five numbers
	Escribir "Ingrese el primer numero: "
	Leer num1
	Escribir "Ingrese el segundo numero: "
	Leer num2
	Escribir "Ingrese el tercero numero: "
	Leer num3
	Escribir "Ingrese el cuarto numero: "
	Leer num4
	Escribir "Ingrese el quinto numero: "
	Leer num5
	
	// Step 3. Calculate the arithmetic average
	promedio <- (num1 + num2 + num3 + num4 + num5) / 5
	
	// Step 4. Display the result
	Escribir "El promedio de los cinco numeros es: ", promedio
	
FinAlgoritmo
