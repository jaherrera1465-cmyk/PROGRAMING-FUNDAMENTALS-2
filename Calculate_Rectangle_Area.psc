Algoritmo Calculate_Rectangle_Area
	// Step 1. Declare variables
	Definir Base, Altura, Area Como Real
	
	// Step 2. Request and read the base and height
	Escribir "Ingrese la base del rectangulo: "
	Leer Base
	Escribir "Ingrese la Altura del rectangulo: "
	Leer Altura
	
	// Step 3. Calculate the area (Base * height)
	Area <- Base * Altura
	
	// Step 4. Display the resut
	Escribir "El area del rectangulo es: ", Area
	
	
FinAlgoritmo
